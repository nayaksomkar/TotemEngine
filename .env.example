# --- Server ---
# PORT and HOST are auto-set by Render in production. Override locally if needed.
PORT=8000
HOST=0.0.0.0

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Pipeline tunables ---
# Max URLs collected across all search queries for a single research request.
MAX_RESULTS=6
# Max pages actually fetched (crawled) per research request.
MAX_PAGES=3
# Per-page navigation timeout in milliseconds.
PAGE_TIMEOUT_MS=30000
# Cap on extracted text per page (characters).
CONTENT_MAX_CHARS=8000

# Optional: comma-separated extra query suffixes applied to every request
# unless the caller overrides via `variants` in the JSON body.
# SEARCH_VARIANTS=pricing,competitors,market share

# --- Sibling microservice URLs (informational; WebHunter does not call these) ---
# Kept here so all three services can share one .env in deployment.
LLMPING_URL=https://llmping.onrender.com
COMPETITOR_ENGINE_URL=https://competitorengine.onrender.com
# RENDER_EXTERNAL_URL is auto-populated by Render on deploy.
